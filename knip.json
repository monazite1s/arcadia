{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": ["app/**/*.{ts,tsx}", "components/**/*.{ts,tsx}", "lib/**/*.{ts,tsx}"],
    "project": ["**/*.{ts,tsx}", "!**/*.test.{ts,tsx}", "!**/*.spec.{ts,tsx}"],
    "ignore": ["**/*.d.ts", "node_modules/**", ".next/**", "out/**", "public/**"],
    "ignoreDependencies": ["@types/*"],
    "next": {
        "entry": [
            "app/layout.tsx",
            "app/page.tsx",
            "app/**/page.tsx",
            "app/**/layout.tsx",
            "app/api/**/*.ts"
        ]
    }
}
